{
  "name": "dsh-fish-ears",
  "version": "0.1.1",
  "type": "module",
  "description": "Local-first speech transcription for DSH: bundled ASR engine, optional cloud omni fallback, HTTP endpoint for bridges, and Bilibili video audio.",
  "license": "MIT",
  "author": "Jiang",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "asr",
    "speech-to-text",
    "sherpa-onnx",
    "sensevoice",
    "bilibili"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "^2.0.3",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ]
}
